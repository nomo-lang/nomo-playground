{
  "name": "nomo-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm run build && wrangler dev",
    "check:cloudflare": "pnpm run build && wrangler deploy --dry-run",
    "smoke:production": "node scripts/smoke-production.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:wasm": "vitest run src/lib/nomo-wasm.test.ts"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.4",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  }
}
